{
  "name": "dynamic-remotion-templates",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "studio": "node scripts/generate-template-registry.mjs && remotion studio src/remotion/index.ts",
    "render": "node scripts/generate-template-registry.mjs && remotion render src/remotion/index.ts",
    "build": "node scripts/generate-template-registry.mjs && vite build",
    "typecheck": "node scripts/generate-template-registry.mjs && tsc --noEmit",
    "audio:sfx": "node scripts/generate-sfx.mjs",
    "audio:minus-plus": "node scripts/generate-minus-plus-audio.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.539",
    "@remotion/player": "^4.0.539",
    "d3-geo": "^3.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.539",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.5"
  }
}
